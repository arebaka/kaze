                  		location: {
                      		name: "PlayStation 5",
                      		type: LocationType.node,
                           	node: {
                          		id: "are.playstation",
                          		type: NodeType.playstation,
                            	size: 825000000000,
                               	used: 302775000000,
                               	available: 522225000000,
                    }}},
                ]}, {
                	heading: "Clouds",
                 	items: [{
                  		location: {
                    		name: "Google Drive",
                      		type: LocationType.cloud,
                        	cloud: { type: CloudType.google-drive },
                    }}, {
                  		location: {
                  		name: "iCloud",
                      		type: LocationType.cloud,
                       	cloud: { type: CloudType.icloud },
                    }}, {
                  		location: {
                      		name: "Яндекс Диск",
                      		type: LocationType.cloud,
                           	cloud: { type: CloudType.yandex-disk },
                    }}, {
                  		location: {
                  		name: "pCloud",
                      		type: LocationType.cloud,
                       	cloud: { type: CloudType.pcloud },
                    }}, {
                  		location: {
                      		name: "S3",
                      		type: LocationType.cloud,
                           	cloud: { type: CloudType.s3 },
                    }},
                ]}];
              	active-section: 1;
             	summary-point: "/home";
             	summary-fill: 76%;
             	summary-percent: "76%";
             	summary-size: "256 G";
             	clicked(section, item) => root.sidebar-clicked(section, item);
         	}
*/
			Rectangle {
				for tab[tab-index] in root.tabs : Rectangle {
					if tab-index == root.active-tab-index && tab.type == ViewType.table : TableView {
						entries: root.entries;
						active-entry-index: root.active-entry-index;
						scroll-position: root.scroll-position;
						folder-count: root.folder-count;
						file-count: root.file-count;
						status-text: root.status-text;
						status-kind: root.status-kind;
						sort-column: root.sort-column;
						sort-direction: root.sort-direction;
						sort(column) => root.sort-by(column);
						click(entry, index) => root.entry-click(entry, index);
						double-click(entry, index) => root.entry-double-click(entry, index);
						sync(entry-index, position) => root.tab-sync(tab-index, entry-index, position);
					}
				}
			}

         	// Inspector {}
        }
    }
}
