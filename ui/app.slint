export component App inherits Window {
	in property <[TabMeta]> tabs;
	in property <int> active-tab-index: -1;
	in property <[Location]> history;
	in property <int> history-index: -1;
	in property <[Location]> breadcrumbs;
	in property <int> breadcrumb-index: -1;
	in property <string> search-placeholder: "";
	in property <string> search-query: "";
	// in property <string> app-title: "";
	// in property <string> app-subtitle: "";
	// in property <[SectionData]> sections;
	// in property <int> active-section;
	// in property <string> summary-point: "";
	// in property <percent> summary-fill: 0%;
	// in property <string> summary-percent: "";
	// in property <string> summary-size: "";
	// in property <[FileData]> files;
	// in property <int> active-file: -1;
	in property <[Entry]> entries;
	in property <int> active-entry-index: -1;
	in property <length> scroll-position: 0;
	in property <int> folder-count: 0;
	in property <int> file-count: 0;
	in property <string> status-text: "";
	in property <StatusKind> status-kind: StatusKind.none;
	in property <SortColumn> sort-column: SortColumn.name;
	in property <SortDirection> sort-direction: SortDirection.ascending;
	in property <bool> can-back: false;
	in property <bool> can-forward: false;
	in property <bool> can-up: false;
	out property <bool> focused <=> handler.has-focus;
	out property <TabMeta> active-tab <=> top.active-tab;
	out property <Location> location <=> tool.location;
	out property <bool> sort-pressed <=> tool.sort-pressed;
	out property <ViewType> view-type <=> tool.view-type;
	out property <bool> back-hover <=> tool.back-hover;
	out property <bool> back-pressed <=> tool.back-pressed;
	out property <bool> forward-hover <=> tool.forward-hover;
	out property <bool> forward-pressed <=> tool.forward-pressed;
	out property <bool> up-hover <=> tool.up-hover;
	out property <bool> up-pressed <=> tool.up-pressed;
	out property <Location> active-breadcrumb <=> tool.active-crumb;
	out property <bool> breadcrumbs-hover <=> tool.breadcrumbs-hover;
	out property <bool> breadcrumbs-copy-hover <=> tool.breadcrumbs-copy-hover;
	out property <bool> breadcrumbs-copy-pressed <=> tool.breadcrumbs-copy-pressed;
	out property <bool> search-focused <=> tool.search-focused;
	out property <string> search-value <=> tool.search-value;
	out property <bool> paste-hover <=> tool.paste-hover;
	out property <bool> paste-pressed <=> tool.paste-pressed;
	out property <bool> filter-hover <=> tool.filter-hover;
	out property <bool> filter-pressed <=> tool.filter-pressed;
	out property <bool> group-hover <=> tool.group-hover;
	out property <bool> group-pressed <=> tool.group-pressed;
	out property <bool> sort-hover <=> tool.sort-hover;
	callback key-pressed(event: KeyEvent) -> bool;
	callback key-released(event: KeyEvent) -> EventResult;
	callback focus-gained(reason: FocusReason);
	callback focus-lost(reason: FocusReason);
	callback tab-switch(index: int);
	callback tab-close(index: int);
	callback tab-new();
	callback tab-sync(tab-index: int, active-entry-index: int, scroll-position: length);
	callback pallete-toggle();
	callback menu-toggle();
	callback entry-click(entry: Entry, index: int);
	callback entry-double-click(entry: Entry, index: int);
	callback navigate-back();
	callback navigate-forward();
	callback navigate-up();
	callback navigate-breadcrumb(index: int);
	callback sort-by(column: SortColumn);

	title: "";
	// icon: "";
	default-font-family: Typography.font-base;
	default-font-size: Typography.size-base;
	default-font-weight: Typography.weight-base;
	preferred-width: 100%;
	preferred-height: 100%;
	min-height: Sizing.height-base;
	max-width: 4320px;
	max-height: 7680px;
	forward-focus: handler;

	// public function sync() {
	// 	tabs[active-tab-index].active-entry-index = active-entry-index;
	// 	tabs[active-tab-index].scroll-position = scroll-position;
	// }

	// public function commit() {
	// 	active-tab = tabs[active-tab-index];
	// 	active-entry-index = active-tab.active-entry-index;
	// 	active-entry = active-tab.entries[active-entry-index];
	// 	active-file = active-entry.file;
	// 	scroll-position = active-tab.scroll-position;
	// }

    public function set-title(title: string) {
        root.title = title;
    }
    public function set-icon(icon: image) {
        root.icon = icon;
    }

    handler := FocusScope {
	   	key-pressed(event) => {
			root.key-pressed(event) ? EventResult.accept : EventResult.reject
		}
	   	key-released(event) => root.key-released(event);
		focus-gained(reason) => root.focus-gained(reason);
		focus-lost(reason) => root.focus-lost(reason);
    }

    VerticalLayout {
    	top := TopBar {
     		tabs: tabs;
        	active-tab-index: active-tab-index;
         	tab-switch(index) => root.tab-switch(index);
			tab-close(index) => root.tab-close(index);
			tab-new() => root.tab-new();
			pallete-toggle() => root.pallete-toggle();
			menu-toggle() => root.menu-toggle();
        }
     	tool := ToolBar {
       		history: history;
        	history-index: history-index;
      		breadcrumbs: breadcrumbs;
			breadcrumb-index: breadcrumb-index;
			search-placeholder: search-placeholder;
			search-query: search-query;
			view-type: active-tab.type;
			can-back: root.can-back;
			can-forward: root.can-forward;
			can-up: root.can-up;
			back => root.navigate-back();
			forward => root.navigate-forward();
			up => root.navigate-up();
			crumb-clicked(index) => root.navigate-breadcrumb(index);
		}
