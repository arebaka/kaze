

import { Icon, String } from "common.slint";
component Preview inherits Rectangle {
	in property <image> image;

	height: 512px;

	Image {
		height: 100%;
		source: image;
	   	image-fit: cover;
	}
}
// @image-url("/home/arelive/photo_2026-04-18_07-24-26.jpg")
component PreviewPalette inherits Rectangle {
	in property <[brush]> colors;

	height: Sizing.height-base;

    HorizontalLayout {
        padding-left: Sizing.padding;
        padding-right: Sizing.padding;

        for color in colors : Rectangle {
       		background: color;
         	horizontal-stretch: 1;
        }
    }
}

export component Action inherits Rectangle {
	in property <string> icon: "";
	in property <string> label: "";
	out property <bool> hover <=> ta.has-hover;

	background: hover ? Palette.background-accent : transparent;
	border-color: Palette.border-base;
	border-width: Sizing.border-width;
	border-radius: Sizing.rad;

	ta := TouchArea { mouse-cursor: default; }
	HorizontalLayout {
		padding-left: Sizing.padding;
		padding-right: Sizing.padding;
		spacing: Sizing.spacing;
		alignment: center;

		if icon != "" : i := Icon { text: icon; }
		s := String { text: label; }
	}
}

component Actions inherits Rectangle {
	height: Sizing.height-base;

	HorizontalLayout {
		padding-left: Sizing.padding;
     	padding-right: Sizing.padding;
     	spacing: Sizing.spacing;

     	Action { icon: "󰛐"; label: "View"; }
     	Action { icon: "󰴒"; label: "Edit"; }
     	Action { icon: "󰆏"; label: "Copy"; }
     	Action { icon: "󱀱"; label: "Move"; }
     	Action { icon: "󰧧"; label: "Delete"; }
	}
}

component FileName inherits Rectangle {
	height: Sizing.height-base;

	HorizontalLayout {
		padding-left: Sizing.padding-double;
		padding-right: Sizing.padding-double;

		ti := TextInput {
			font-family: Typography.font-base;
			font-size: Typography.size-base;
			font-weight: Typography.weight-bold;
			color: Palette.foreground-accent;
			selection-foreground-color: Palette.foreground-select;
			selection-background-color: Palette.background-select;
			text-cursor-width: Typography.width-cursor;
			text: "photo_2026-04-18_07-24-26.jpg";
			vertical-alignment: center;
			input-type: text;
			read-only: true;
		}
		IconButton { icon: "󰏫"; }
	}
}

component FilePath inherits Rectangle {
	height: Sizing.height-base;

	HorizontalLayout {
		padding-left: Sizing.padding-double;
		padding-right: Sizing.padding-double;

    	String { text: "/home/arelive/photo_2026-04-18_07-24-26.jpg"; }
		IconButton { icon: "󰆏"; }
	}
}

component Meta inherits Rectangle {
	VerticalLayout {
		padding-left: Sizing.padding;
		padding-right: Sizing.padding;

		@children
	}
}

component Openers inherits Rectangle {
	height: Sizing.height-base;

	HorizontalLayout {
		padding-left: Sizing.padding;
		padding-right: Sizing.padding;
		spacing: Sizing.spacing;

		OpenerIcon { icon: @image-url("https://upload.wikimedia.org/wikipedia/commons/4/45/The_GIMP_icon_-_gnome.svg?download"); }
		OpenerIcon { icon: @image-url("https://upload.wikimedia.org/wikipedia/commons/6/62/Pinta_icon.png?download"); }
		OpenerIcon { icon: @image-url("https://upload.wikimedia.org/wikipedia/commons/7/73/Calligrakrita-base.svg?download"); }
		OpenerIcon { icon: @image-url("https://upload.wikimedia.org/wikipedia/commons/a/a0/Firefox_logo%2C_2019.svg?download"); }
		OpenerIcon { icon: @image-url("https://upload.wikimedia.org/wikipedia/commons/e/e1/Google_Chrome_icon_%28February_2022%29.svg?download"); }
		Rectangle { horizontal-stretch: 1; }
		Action {
			label: "Open with...";
			border-width: 0;
	 	}
	}
}

component Inspector inherits Rectangle {
	width: 610px;
	background: Palette.background-surface;

	ScrollView {
		mouse-drag-pan-enabled: true;

		VerticalLayout {
			spacing: Sizing.spacing;

			Preview {}
			PreviewPalette {}
			Actions {}
			Openers {}
			VerticalLayout {
				FileName {}
				FilePath {}
				Meta {
					MetaSection {
						heading: "General";

						MetaRow { key: "MIME"; value: "image/jpeg"; }
						MetaRow { key: "Size"; value: "186.0 K"; }
						MetaRow { key: "Raw size"; value: "190459"; }
						MetaRow { key: "Blocks"; value: "276"; }
						MetaRow { key: "Hard links"; value: "1"; }
