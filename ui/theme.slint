export global Palette {
	out property <string> name: "dark";

	out property <brush> palette-00: oklch(68%, 0.102, 10);
	out property <brush> palette-01: oklch(68%, 0.102, 40);
	out property <brush> palette-02: oklch(68%, 0.102, 70);
	out property <brush> palette-03: oklch(68%, 0.102, 100);
	out property <brush> palette-04: oklch(68%, 0.102, 130);
	out property <brush> palette-05: oklch(68%, 0.102, 160);
	out property <brush> palette-06: oklch(68%, 0.102, 190);
	out property <brush> palette-07: oklch(68%, 0.102, 220);
	out property <brush> palette-08: oklch(68%, 0.102, 250);
	out property <brush> palette-09: oklch(68%, 0.102, 280);
	out property <brush> palette-10: oklch(68%, 0.102, 310);
	out property <brush> palette-11: oklch(68%, 0.102, 340);

    out property <brush> background-base: oklch(12%, 0.002, 100);
    out property <brush> background-surface: oklch(18%, 0.002, 100);
    out property <brush> background-accent: oklch(24%, 0.002, 100);
    out property <brush> background-muted: transparent;
    out property <brush> background-select: palette-07;
    out property <brush> foreground-base: oklch(64%, 0.002, 280);
    out property <brush> foreground-surface: foreground-base;
    out property <brush> foreground-accent: oklch(94%, 0.002, 280);
    out property <brush> foreground-muted: oklch(40%, 0.002, 280);
    out property <brush> foreground-select: background-base;

    out property <brush> border-base: oklch(40%, 0.002, 280);
    out property <brush> border-accent: oklch(64%, 0.002, 280);

    out property <brush> success: palette-04;
    out property <brush> warning: palette-02;
    out property <brush> error: palette-00;
    out property <brush> danger: palette-00;
}

export global Sizing {
    out property <length> padding: 8px;
    out property <length> spacing: 8px;
    out property <length> height-base: 32px;
    out property <length> height-small: 18px;
    out property <length> border-width: 1px;
    out property <length> rad: 8px;
}

